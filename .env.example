# N-ATLaS Environment Configuration Template
# Hugging Face Hub Access Token (Required for downloading gated model weights from NCAIR1/N-ATLaS)
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# NATLAS API Security Key (Secret used to authenticate client requests to /v1/* endpoints)
NATLAS_API_KEY=your_secure_api_key_here

# Model Repository Identifier on Hugging Face
NATLAS_MODEL_ID=NCAIR1/N-ATLaS

# Modal Deployment Endpoints (Generated after running `modal deploy natlas_engine.py`):
NATLAS_API_URL=https://<your-modal-workspace>--natlas-engine-natlasapi-serve.modal.run

# 2. Sovereign ASR Engine (Speech-to-Text & Word Alignment)
NATLAS_ASR_URL=https://<your-modal-workspace>--natlas-engine-natlasasrengine-serve.modal.run

# ─────────────────────────────────────────────────────────
# PLAYGROUND (playground/.env) — Vite apps require VITE_ prefix
# Copy the values above into playground/.env with VITE_ prefix:
# ─────────────────────────────────────────────────────────
# VITE_NATLAS_API_URL=<same as NATLAS_API_URL above>
# VITE_NATLAS_ASR_URL=<same as NATLAS_ASR_URL above>
# VITE_NATLAS_API_KEY=<same as NATLAS_API_KEY above>
#
# Or run: cp .env playground/.env && sed -i 's/^NATLAS_/VITE_NATLAS_/g' playground/.env
