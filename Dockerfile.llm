FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# System dependencies for CPU acceleration & downloads
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch & Transformers with CPU optimization (pinned to match Modal image)
RUN pip install --no-cache-dir \
    "typing-extensions>=4.12.0" \
    "torch==2.4.0" \
    "transformers==4.46.0" \
    "accelerate>=0.34.0" \
    "sentencepiece>=0.2.0" \
    "protobuf" \
    "safetensors>=0.4.5" \
    "fastapi[standard]>=0.115.0" \
    "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.8.0" \
    "python-multipart>=0.0.12" \
    "websockets>=13.0" \
    "huggingface_hub>=0.28.0" \
    "hf-transfer>=0.1.8" \
    "numpy>=1.26.0"

# Copy application files
COPY natlas_engine.py /app/

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "natlas_engine:create_llm_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
