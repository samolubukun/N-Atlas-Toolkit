FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# System dependencies for audio decoding and sound processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PyTorch & core ASR + FastAPI dependencies (pinned to match Modal image)
RUN pip install --no-cache-dir \
    "typing-extensions>=4.12.0" \
    "torch==2.4.0" \
    "torchaudio==2.4.0" \
    "transformers==4.46.0" \
    "accelerate>=0.34.0" \
    "librosa>=0.10.0" \
    "soundfile>=0.12.1" \
    "fastapi[standard]>=0.115.0" \
    "uvicorn[standard]>=0.30.0" \
    "pydantic>=2.8.0" \
    "python-multipart>=0.0.12" \
    "websockets>=13.0" \
    "huggingface_hub>=0.28.0" \
    "hf-transfer>=0.1.8" \
    "sentencepiece>=0.2.0" \
    "numpy>=1.26.0" \
    "scipy>=1.11.0"

# Copy SDK and install
COPY python-sdk /app/python-sdk
RUN pip install --no-cache-dir -e /app/python-sdk

# Copy application files
COPY natlas_engine.py /app/

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "natlas_engine:create_asr_app", "--factory", "--host", "0.0.0.0", "--port", "8001"]
