# N-ATLaS Environment Configuration Template
# Hugging Face Hub Access Token (Required for downloading gated model weights from NCAIR1/N-ATLaS)
HF_TOKEN=your_huggingface_token_here
HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

# NATLAS API Security Key (Secret used to authenticate client requests to /v1/* endpoints)
NATLAS_API_KEY=your_secure_api_key_here

# Modal Deployment Endpoints:
# 1. LLM Engine (Chat, Completions, Translation, Africanize)
NATLAS_BASE_URL=https://samuelolubukun--natlas-engine-natlasapi-serve.modal.run

# 2. Sovereign ASR Engine (Speech-to-Text & Deepgram-Style Streaming WebSocket)
NATLAS_ASR_URL=https://samuelolubukun--natlas-engine-natlasasrengine-serve.modal.run
